# Civitas Access · Servidor de notificaciones push
# Puerto HTTP del servidor
PORT=8790

# Ruta del archivo SQLite (relativa al directorio del proyecto)
DATABASE_PATH=./data/push.sqlite

# Token de acceso de Expo (Enhanced Push Security). Opcional en desarrollo.
EXPO_ACCESS_TOKEN=

# Credenciales del panel web (ADMIN_PASSWORD es OBLIGATORIA: mínimo 12 caracteres
# y no puede ser un valor por defecto, si no el servidor no arranca)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-larga

# Secreto para firmar la cookie de sesión (usa una cadena aleatoria larga)
SESSION_SECRET=cambia-este-secreto

# Pepper (secreto) con el que se calcula el hash de las API keys.
# Si lo cambias, todas las API keys existentes dejan de ser válidas.
API_KEY_PEPPER=cambia-este-pepper

# Confiar en cabeceras X-Forwarded-For / X-Real-IP (pon true si hay reverse proxy)
TRUST_PROXY=false

# CORS: origen permitido para la API. Déjalo vacío para no emitir cabeceras CORS
# (los clientes móviles no las necesitan); usa un origen concreto si hay frontend web.
CORS_ORIGIN=

# Límite de intentos de login por IP en 5 minutos (por defecto 10)
LOGIN_RATE_LIMIT_MAX=10

# Límite de peticiones por IP a /v1/* por minuto (por defecto 120)
API_RATE_LIMIT_MAX=120
